{
  "name": "mailfile-viewer",
  "version": "0.1.0",
  "description": "Open and convert MSG, EML, winmail.dat, PST/OST, OLM and MBOX email files locally in the browser",
  "scripts": {
    "test": "node --test test/core.test.mjs && python3 -I test/verify_exports.py",
    "build": "node scripts/build.mjs",
    "test:e2e": "npm run build && node test/e2e.mjs",
    "serve": "python3 -m http.server -d docs 8765"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@kenjiuno/msgreader": "1.29.0",
    "buffer": "6.0.3",
    "fast-xml-parser": "4.5.0",
    "fflate": "0.8.2",
    "postal-mime": "2.7.6",
    "pst-extractor": "1.12.0",
    "string_decoder": "1.3.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "playwright": "1.55.0"
  }
}
